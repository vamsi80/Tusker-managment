# Single .env at the repo root, shared by every app and package.
#   apps/web   loads it via next.config.ts (dotenv)
#   apps/api   loads it via node's --env-file flag
#   packages/db  loads it for the Prisma CLI scripts
# Copy to .env and fill in. Values are validated by packages/core/src/lib/env.ts.

# ---------- Database (required) ----------
# Pooled connection used by the app; DIRECT_URL bypasses the pooler for migrations.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ---------- Auth (required) ----------
# Must be at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in (optional; the provider stays unusable until both are set)
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_SECRET=

# ---------- Service URLs ----------
# Where the web app proxies /api/v1/* . In compose this is http://api:4000
API_URL=http://localhost:4000
# Port the standalone API listens on
API_PORT=4000
# Public origin of the web app (used for absolute URLs during SSR)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Only set if a client should bypass the web proxy and call the API directly
# (native clients use EXPO_PUBLIC_API_URL).
# NEXT_PUBLIC_API_URL=

# ---------- Email / SMTP (required) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ---------- Object storage, S3 or Cloudflare R2 (optional) ----------
# Uploads are disabled while unset.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
NEXT_PUBLIC_S3_BUCKET_NAME=
# R2: https://<accountid>.r2.cloudflarestorage.com — omit for plain AWS S3.
S3_ENDPOINT=

# ---------- Realtime, Pusher (optional) ----------
# Falls back to a no-op provider in development while unset.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ---------- Integrations (optional) ----------
# GSTIN verification: https://www.gstinapi.in
GSTIN_API_KEY=
# Shared secret for the /api/v1/cron endpoints
CRON_SECRET=
# Shared secret for the face-recognition attendance kiosk
ATTENDANCE_DEVICE_SECRET=

# ---------- Local toggles ----------
# SKIP_ENV_VALIDATION=1
# NEXT_PUBLIC_ENABLE_PERF_LOGS=1
# RUN_DB_INTEGRATION_TESTS=1
