# =============================================================================
# Trava-App Mobile (Expo) — environment template
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Only EXPO_PUBLIC_* values are exposed to the client bundle; do not put
# secrets here.
# =============================================================================

# --- Pusher (realtime, public client keys) ---
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=

# --- API ---
# Origin serving /api/v1. In production this is the Vercel deployment, which
# serves the web app and the API from one domain:
#   https://<project>.vercel.app
# No trailing slash and no /api/v1 - src/services/api.ts appends the path.
#
# For local work against the standalone API (apps/api, `pnpm dev:api`) a device
# or emulator cannot reach your computer on localhost, so use its LAN address:
#   simulator on this machine : http://localhost:4000
#   physical device / emulator: http://192.168.x.x:4000
# Note Android 9+ blocks cleartext HTTP in release builds - LAN addresses only
# work in dev builds. Release builds must use the https:// deployment.
EXPO_PUBLIC_API_BASE=http://localhost:4000
