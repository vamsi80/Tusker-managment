# Origin serving /api/v1 — the Vercel deployment serves the web app and the API
# from one domain. No trailing slash and no /api/v1.
#   physical device / emulator against a local API: http://192.168.x.x:4000
EXPO_PUBLIC_API_BASE=https://tusker-managment.vercel.app

# Pusher (realtime) public client keys — same values the web app uses.
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=ap2
