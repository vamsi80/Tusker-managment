{
  "expo": {
    "name": "drava core",
    "slug": "trava-tasks",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": ["dravaapp", "travaapp", "tusker"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#131416",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thewhitetusker.trava",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.thewhitetusker.trava",
      "versionCode": 22,
      "adaptiveIcon": {
        "backgroundColor": "#393B3D",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#393B3D",
          "dark": {
            "backgroundColor": "#393B3D"
          }
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "drava core uses your location to mark attendance at a site."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "drava core lets you attach photos to tasks, comments and status updates.",
          "cameraPermission": "drava core uses the camera to attach site photos to tasks.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withLargeScreenSupport"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "owner": "suf007s-organization",
    "extra": {
      "eas": {
        "projectId": "82e37076-44ec-4eda-8bd3-8998c361a93c"
      }
    }
  }
}
