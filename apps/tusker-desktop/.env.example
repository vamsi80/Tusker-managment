# Pusher's public app key and cluster: the same values as NEXT_PUBLIC_PUSHER_KEY /
# NEXT_PUBLIC_PUSHER_CLUSTER on the website. Without them the app still works,
# but refreshes on focus instead of live.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap2

# Optional, read by the main process at launch (not baked into the build):
# TUSKER_API_BASE=http://localhost:4000
