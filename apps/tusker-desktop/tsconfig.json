{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "next/navigation": [
        "./src/next/navigation.ts"
      ],
      "next/link": [
        "./src/next/link.tsx"
      ],
      "next/dynamic": [
        "./src/next/dynamic.tsx"
      ],
      "next/image": [
        "./src/next/image.tsx"
      ],
      "@tusker/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@tusker/api-client/*": [
        "../../packages/api-client/src/*"
      ],
      "@tusker/core": [
        "../../packages/core/src/index.ts"
      ],
      "@tusker/core/*": [
        "../../packages/core/src/*"
      ],
      "@mobile/api/*": [
        "../mobile/src/api/*"
      ],
      "~/*": [
        "./src/*"
      ],
      "@/*": [
        "../web/src/*"
      ],
      "react-native": [
        "./src/type-stubs/react-native.d.ts"
      ],
      "@react-native-async-storage/async-storage": [
        "./src/type-stubs/async-storage.d.ts"
      ],
      "expo-secure-store": [
        "./src/type-stubs/expo-secure-store.d.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
