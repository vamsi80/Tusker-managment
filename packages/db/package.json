{
  "name": "@tusker/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:seed": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs prisma/seed-units.ts",
    "db:migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "db:push": "node --env-file=../../.env ./node_modules/prisma/build/index.js db push",
    "db:studio": "node --env-file=../../.env ./node_modules/prisma/build/index.js studio",
    "db:validate": "node --env-file=../../.env ./node_modules/prisma/build/index.js validate"
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "tsx": "^4.21.0"
  }
}
