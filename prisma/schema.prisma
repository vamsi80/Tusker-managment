generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String              @id
  name                String
  email               String              @unique
  emailVerified       Boolean             @default(false)
  image               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  role                String?
  banned              Boolean?            @default(false)
  banReason           String?
  banExpires          DateTime?
  surname             String?
  phoneNumber         String?             @unique
  phoneNumberVerified Boolean             @default(false)
  pushToken           String?
  lastActiveAt        DateTime?           @default(now())
  activities          Activity[]
  workspaceOwner      Workspace[]
  workspaces          WorkspaceMember[]
  UserConversations   UserConversations[]
  accounts            Account[]
  activityReads       ActivityRead[]
  auditLogs           AuditLog[]
  comments            Comment[]
  commentReads        CommentRead[]
  dailyReports        DailyReport[]
  direct_message      direct_message[]
  notification        notification[]
  sessions            Session[]
  organizedMeetings   Meeting[]           @relation("MeetingOrganizer")
  meetingAttendees    MeetingAttendee[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Workspace {
  id                     String                     @id @default(uuid())
  name                   String
  slug                   String                     @unique
  description            String?
  ownerId                String
  createdAt              DateTime                   @default(now())
  image_url              String                     @default("")
  updatedAt              DateTime                   @updatedAt
  inviteCode             String                     @unique
  addressLine1           String?
  addressLine2           String?
  city                   String?
  companyType            String?
  country                String?
  email                  String?
  gstNumber              String?
  industry               String?
  legalName              String?
  msmeNumber             String?
  panNumber              String?
  phone                  String?
  pincode                String?
  state                  String?
  website                String?
  lateThreshold          String                     @default("21:30")
  overtimeThreshold      String                     @default("07:00")
  halfDayThreshold       String                     @default("23:00")
  shiftEndTime           String                     @default("07:00")
  shiftStartTime         String                     @default("21:30")
  sickLeaveLimit         Int                        @default(12)
  casualLeaveAccrualDays Int                        @default(20)
  nextVendorNumber       Int                        @default(1)
  nextMaterialNumber     Int                        @default(1)
  permissionOverrides    Json?
  clints                 Clints[]
  projects               Project[]
  tags                   Tag[]
  owner                  User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members                WorkspaceMember[]
  attendance             attendance[]
  attendanceLocations    AttendanceLocation[]
  auditLogs              AuditLog[]
  boardItems             Board[]
  conversation           conversation[]
  dailyReports           DailyReport[]
  indents                Indent[]
  leaveRequests          leave_request[]
  materialCatalog        MaterialCatalog[]
  notifications          notification[]
  publicHolidays         public_holiday[]
  units                  UnitOfMeasure[]
  vendors                Vendor[]
  vendorCapabilities     VendorMaterialCapability[]
  purchaseOrders         PurchaseOrder[]
  departments            Department[]
  shiftSchedules         ShiftSchedule[]
  meetings               Meeting[]
}

/// A set of check-in/check-out times shared by every department that points at it.
/// Seeded as "Head Office" and "Factory"; a workspace can add more without a migration.
model ShiftSchedule {
  id                String       @id @default(uuid())
  workspaceId       String
  name              String
  lateThreshold     String
  halfDayThreshold  String
  shiftStartTime    String
  shiftEndTime      String
  overtimeThreshold String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departments       Department[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Department {
  id              String            @id @default(uuid())
  workspaceId     String
  name            String
  shiftScheduleId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shiftSchedule   ShiftSchedule?    @relation(fields: [shiftScheduleId], references: [id], onDelete: SetNull)
  members         WorkspaceMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model WorkspaceMember {
  id                          String                @id @default(uuid())
  userId                      String
  workspaceId                 String
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  workspaceRole               WorkspaceRole         @default(MEMBER)
  designation                 String?
  reportToId                  String?
  accruedDaysCount            Int                   @default(0)
  casualLeaveBalance          Float                 @default(0)
  sickLeaveBalance            Float                 @default(12)
  position                    Int                   @default(0)
  dateOfBirth                 DateTime?
  employeeId                  String?
  permissionOverrides         Json?
  departmentId                String?
  department                  Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managedProjects             Project[]             @relation("ProjectManager")
  projectMembers              ProjectMember[]
  reportTo                    WorkspaceMember?      @relation("ReportTo", fields: [reportToId], references: [id])
  subordinates                WorkspaceMember[]     @relation("ReportTo")
  user                        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace                   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attendance                  attendance[]
  assignedBoardItems          Board[]               @relation("BoardAssigner")
  boardItems                  Board[]               @relation("BoardMember")
  indentsAssigned             Indent[]              @relation("IndentAssignee")
  indentsApproved             Indent[]              @relation("IndentFinalApprover")
  indentsFinalRatesSubmitted  Indent[]              @relation("IndentFinalRatesSubmitter")
  indentsFinalManagerApproved Indent[]              @relation("IndentFinalManagerApprover")
  indentsManagerApproved      Indent[]              @relation("IndentManagerApprover")
  indentsRequested            Indent[]              @relation("IndentRequester")
  processedLeaveRequests      leave_request[]       @relation("LeaveProcessor")
  leaveRequests               leave_request[]
  memberTodos                 MemberTodo[]
  quotesReviewed              VendorQuote[]         @relation("QuoteReviewer")
  addedMaterialItems          ProjectMaterialItem[]
  purchaseOrdersCreated       PurchaseOrder[]        @relation("POCreator")

  @@unique([userId, workspaceId])
  @@unique([workspaceId, employeeId])
  @@index([workspaceId, workspaceRole])
  @@index([workspaceId, departmentId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId, userId])
  @@index([workspaceRole])
  @@index([userId])
}

model Project {
  id               String                @id @default(uuid())
  name             String
  description      String?
  workspaceId      String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  slug             String                @unique
  color            String
  createdBy        String?
  projectManagerId String?
  clintId          String?
  /// Which of the three business verticals this project belongs to. Nullable
  /// because projects created before categories existed have no answer yet.
  category         ProjectCategory?
  legacyClints     Clints[]              @relation("LegacyProjectClints")
  clint            Clints?               @relation(fields: [clintId], references: [id])
  projectManager   WorkspaceMember?      @relation("ProjectManager", fields: [projectManagerId], references: [id])
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectMembers   ProjectMember[]
  tasks            Task[]
  indents          Indent[]
  materialItems    ProjectMaterialItem[]
  tags             Tag[]                 @relation("ProjectTags")
  meetings         Meeting[]

  @@index([workspaceId, slug])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, createdBy])
}

model ProjectMember {
  id                String          @id @default(uuid())
  projectId         String
  createdAt         DateTime        @default(now())
  hasAccess         Boolean         @default(false)
  projectRole       ProjectRole     @default(MEMBER)
  updatedAt         DateTime        @updatedAt
  workspaceMemberId String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspaceMember   WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  assignedTasks     Task[]          @relation("TaskAssignee")
  createdTasks      Task[]          @relation("TaskCreator")
  reviewingTasks    Task[]          @relation("TaskReviewer")

  @@unique([workspaceMemberId, projectId])
  @@index([projectId, projectRole])
  @@index([workspaceMemberId])
  @@index([projectId, workspaceMemberId])
}

model Clints {
  id                    String         @id @default(uuid())
  name                  String?
  registeredCompanyName String?
  gstNumber             String?
  directorName          String?
  address               String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  projectId             String?
  workspaceId           String?
  clintMembers          ClintMembers[]
  legacyProject         Project?       @relation("LegacyProjectClints", fields: [projectId], references: [id])
  workspace             Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects              Project[]

  @@index([workspaceId])
}

model ClintMembers {
  id          String   @id @default(uuid())
  name        String?
  email       String?
  clintId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  phoneNumber String?
  clints      Clints?  @relation(fields: [clintId], references: [id], onDelete: Cascade)

  @@index([clintId])
}

model Tag {
  id              String    @id @default(uuid())
  name            String
  workspaceId     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  requirePurchase Boolean?  @default(false)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks           Task[]    @relation("TaskTags")
  projects        Project[] @relation("ProjectTags")

  @@unique([workspaceId, name])
}

model Task {
  id                    String                @id @default(uuid())
  projectId             String
  description           String?
  status                TaskStatus?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  createdById           String
  days                  Int?
  name                  String
  parentTaskId          String?
  startDate             DateTime?
  taskSlug              String                @unique
  assigneeId            String?
  completedSubtaskCount Int                   @default(0)
  dueDate               DateTime?
  isParent              Boolean               @default(true)
  path                  String?
  reviewerId            String?
  subtaskCount          Int                   @default(0)
  workspaceId           String
  position              Int                   @default(0)
  activities            Activity[]
  assignee              ProjectMember?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy             ProjectMember         @relation("TaskCreator", fields: [createdById], references: [id])
  parentTask            Task?                 @relation("Task_subTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks              Task[]                @relation("Task_subTasks")
  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer              ProjectMember?        @relation("TaskReviewer", fields: [reviewerId], references: [id])
  comments              Comment[]
  dailyReportEntries    DailyReportEntry[]
  indent                Indent?
  Task_TaskDependency_A Task[]                @relation("TaskDependency")
  Task_TaskDependency_B Task[]                @relation("TaskDependency")
  tags                  Tag[]                 @relation("TaskTags")
  materialItems         ProjectMaterialItem[]

  @@index([projectId, status, isParent, createdAt(sort: Desc)])
  @@index([workspaceId, status, isParent])
  @@index([workspaceId, projectId, status, isParent, dueDate, createdAt(sort: Desc)])
  @@index([parentTaskId, createdAt])
  @@index([workspaceId, parentTaskId, status, isParent, createdAt(sort: Desc)])
  @@index([workspaceId, assigneeId, status, createdAt])
  @@index([projectId, assigneeId, status, createdAt])
  @@index([name, id])
  @@index([startDate, id])
  @@index([dueDate, id])
  @@index([createdAt(sort: Desc), id])
  @@index([workspaceId, assigneeId, updatedAt(sort: Desc)])
}

model Activity {
  id          String         @id @default(uuid())
  subTaskId   String
  authorId    String
  text        String
  attachment  Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspaceId String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subTask     Task           @relation(fields: [subTaskId], references: [id], onDelete: Cascade)
  readBy      ActivityRead[]

  @@index([subTaskId, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([workspaceId])
}

model ActivityRead {
  id         String   @id @default(uuid())
  userId     String
  activityId String
  createdAt  DateTime @default(now())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@index([userId])
  @@index([activityId])
  @@map("activity_read")
}

model Comment {
  id              String        @id @default(uuid())
  content         String
  userId          String
  taskId          String
  parentCommentId String?
  isEdited        Boolean       @default(false)
  editedAt        DateTime?
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  parentComment   Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]     @relation("CommentReplies")
  task            Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  readBy          CommentRead[]

  @@index([taskId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([parentCommentId])
  @@index([createdAt])
  @@map("comment")
}

model CommentRead {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([userId])
  @@index([commentId])
  @@map("comment_read")
}

model DailyReport {
  id              String             @id @default(uuid())
  workspaceId     String
  userId          String
  date            DateTime           @db.Date
  status          ReportStatus
  submittedAt     DateTime?
  isAutoGenerated Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  entries         DailyReportEntry[]
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, date])
  @@index([workspaceId, date])
  @@map("daily_reports")
}

model DailyReportEntry {
  id          String          @id @default(uuid())
  reportId    String
  taskId      String?
  type        ReportEntryType
  description String?
  createdAt   DateTime        @default(now())
  report      DailyReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  task        Task?           @relation(fields: [taskId], references: [id])

  @@index([reportId])
  @@index([taskId])
  @@map("daily_report_entries")
}

model attendance {
  id                String           @id
  workspaceId       String
  workspaceMemberId String
  date              DateTime         @db.Date
  checkIn           DateTime?
  checkOut          DateTime?
  checkInLatitude   Float?
  checkInLongitude  Float?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  status            AttendanceStatus @default(PRESENT)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  checkInAddress    String?
  checkOutAddress   String?
  isOvertime        Boolean          @default(false)
  lateThreshold     String?
  overtimeThreshold String?
  checkInNotes      String?
  checkOutNotes     String?
  Workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  WorkspaceMember   WorkspaceMember  @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([workspaceMemberId, date])
  @@index([workspaceId, date])
}

model AttendanceLocation {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  address     String?
  latitude    Float
  longitude   Float
  radius      Float     @default(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("attendance_locations")
}

model Board {
  id           String          @id @default(uuid())
  workspaceId  String
  memberId     String
  assignedById String
  note         String
  status       BoardStatus     @default(NOT_DONE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  assignedBy   WorkspaceMember @relation("BoardAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  member       WorkspaceMember @relation("BoardMember", fields: [memberId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([memberId])
  @@index([assignedById])
  @@map("board_items")
}

model AuditLog {
  id          String     @id @default(uuid())
  workspaceId String?
  userId      String
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_log")
}

model conversation {
  id                String              @id @default(uuid())
  workspaceId       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  lastMessageAt     DateTime?           @default(now())
  type              String              @default("direct")
  UserConversations UserConversations[]
  Workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  direct_message    direct_message[]

  @@index([workspaceId])
  @@index([lastMessageAt])
}

model direct_message {
  id             String       @id @default(uuid())
  content        String
  createdAt      DateTime     @default(now())
  senderId       String
  conversationId String
  isDeleted      Boolean      @default(false)
  isRead         Boolean      @default(false)
  updatedAt      DateTime     @default(now()) @updatedAt
  conversation   conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model notification {
  id          String    @id
  userId      String
  workspaceId String
  title       String
  body        String
  type        String
  isRead      Boolean   @default(false)
  entityId    String?
  entityType  String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, workspaceId])
}

model leave_request {
  id                String           @id @default(uuid())
  workspaceId       String
  workspaceMemberId String
  startDate         DateTime         @db.Date
  endDate           DateTime         @db.Date
  reason            String
  status            LeaveStatus      @default(PENDING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  type              LeaveType        @default(CASUAL)
  processedById     String?
  processedBy       WorkspaceMember? @relation("LeaveProcessor", fields: [processedById], references: [id])
  Workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  WorkspaceMember   WorkspaceMember  @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceMemberId])
}

model public_holiday {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  date        DateTime  @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
}

model UserConversations {
  A            String
  B            String
  user         User         @relation(fields: [A], references: [id], onDelete: Cascade)
  conversation conversation @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_UserConversations_AB_pkey")
  @@index([B], map: "_UserConversations_B_index")
  @@map("_UserConversations")
}

model MemberTodo {
  id          String          @id @default(uuid())
  memberId    String
  text        String
  completed   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  updatedAt   DateTime        @updatedAt
  position    Int             @default(0)
  member      WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_todos")
}

model VendorMaterialCapability {
  id                String                @id @default(cuid())
  vendorId          String
  materialCatalogId String?
  materialName      String
  unit              String?
  workspaceId       String
  source            String                @default("MANUAL")
  /// Rate agreed with this vendor, in paise. Set by hand so a material with no
  /// approved indent behind it still carries a price to negotiate from.
  rate              Int?
  /// http(s) link to whatever backs the entry — a photo of the material, a
  /// quotation PDF, a catalogue page. Opened in a new tab, never rendered.
  link              String?
  /// Quantity the rate was agreed for. Multiplied by rate for the row total.
  quantity          Int?
  createdAt         DateTime              @default(now())
  serviceType       CapabilityServiceType @default(SUPPLY)
  material          MaterialCatalog?      @relation(fields: [materialCatalogId], references: [id], onDelete: SetNull)
  vendor            Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([vendorId, materialName, serviceType])
  @@index([materialCatalogId])
  @@index([workspaceId, materialName])
  @@map("vendor_material_capability")
}

model MaterialCatalog {
  id                 String                     @id @default(cuid())
  materialId         String
  workspaceId        String
  name               String
  unit               String?
  source             String                     @default("INDENT")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  defaultUnitId      String?
  defaultUnit        UnitOfMeasure?             @relation(fields: [defaultUnitId], references: [id])
  indentLineItems    IndentLineItem[]
  vendorCapabilities VendorMaterialCapability[]
  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@unique([workspaceId, materialId])
  @@index([workspaceId])
  @@map("material_catalog")
}

model UnitOfMeasure {
  id           String            @id @default(cuid())
  workspaceId  String
  name         String
  abbreviation String
  category     String?
  isDefault    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  materials    MaterialCatalog[]
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, abbreviation])
  @@index([workspaceId])
  @@map("unit_of_measure")
}

model Indent {
  id                       String           @id @default(uuid())
  indentId                 String?          @unique
  workspaceId              String
  /// Null for a general indent raised in the global hub with no project. Those
  /// are visible only in the workspace-wide indent list.
  projectId                String?
  taskId                   String?          @unique
  name                     String
  description              String?
  status                   IndentStatus     @default(DRAFT)
  expectedDelivery         DateTime?
  taxPercent               Decimal?         @db.Decimal(5, 2)
  exciseDutyPercent        Decimal?         @db.Decimal(5, 2)
  vatPercent               Decimal?         @db.Decimal(5, 2)
  transportCharge          Int?
  labourCharge             Int?
  requestedById            String
  /// Raised from inside a project (its procurement tab or create page) rather
  /// than the global procurement hub. Decides who owns the manager approval:
  /// the project manager, or the raiser's reporting manager.
  raisedInProject          Boolean          @default(false)
  assignedToId             String?
  submittedAt              DateTime?
  finalApprovedAt          DateTime?
  finalApprovedById        String?
  ownerAuthorizedAt        DateTime?
  finalRatesSubmittedAt    DateTime?
  finalRatesSubmittedById  String?
  finalManagerApprovedAt   DateTime?
  finalManagerApprovedById String?
  managerApprovedAt        DateTime?
  managerApprovedById      String?
  cancelledAt              DateTime?
  cancelReason             String?
  approverIds              String[]         @default([])
  approvedByIds            String[]         @default([])
  finalOwnerApprovedByIds  String[]         @default([])
  rejectedAt               DateTime?
  rejectedById             String?
  rejectedFromStatus       String?
  rejectedStage            String?
  rejectionReason          String?
  revisionCount            Int              @default(0)
  selectedVendorId         String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  assignedTo               WorkspaceMember? @relation("IndentAssignee", fields: [assignedToId], references: [id])
  selectedVendor           Vendor?          @relation("IndentVendor", fields: [selectedVendorId], references: [id])
  finalApprovedBy          WorkspaceMember? @relation("IndentFinalApprover", fields: [finalApprovedById], references: [id])
  finalRatesSubmittedBy    WorkspaceMember? @relation("IndentFinalRatesSubmitter", fields: [finalRatesSubmittedById], references: [id])
  finalManagerApprovedBy   WorkspaceMember? @relation("IndentFinalManagerApprover", fields: [finalManagerApprovedById], references: [id])
  managerApprovedBy        WorkspaceMember? @relation("IndentManagerApprover", fields: [managerApprovedById], references: [id])
  project                  Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy              WorkspaceMember  @relation("IndentRequester", fields: [requestedById], references: [id])
  task                     Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace                Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lineItems                IndentLineItem[]
  purchaseOrders           PurchaseOrder[]

  @@index([workspaceId, status])
  @@index([projectId, status])
  @@index([taskId])
  @@index([requestedById])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("indent")
}

model IndentLineItem {
  id                 String           @id @default(uuid())
  indentId           String
  materialCatalogId  String?
  materialName       String
  description        String?
  unit               String
  quantity           Int
  estimatedUnitPrice Int?
  finalUnitPrice     Int?
  specifications     String?
  status             LineItemStatus   @default(PENDING)
  rfqSentAt          DateTime?
  rfqDeadline        DateTime?
  approvedQuoteId    String?
  rejectionReason    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  approvedQuote      VendorQuote?     @relation("ApprovedQuote", fields: [approvedQuoteId], references: [id])
  indent             Indent           @relation(fields: [indentId], references: [id], onDelete: Cascade)
  material           MaterialCatalog? @relation(fields: [materialCatalogId], references: [id], onDelete: SetNull)
  vendorQuotes       VendorQuote[]

  @@index([indentId])
  @@index([materialCatalogId])
  @@index([status])
  @@index([materialName])
  @@map("indent_line_item")
}

model Vendor {
  id                   String       @id @default(uuid())
  vendorId             String
  name                 String
  companyName          String?
  contactPerson        String?
  email                String?
  address              String?
  gstNumber            String?
  hasGst               Boolean      @default(false)
  workspaceId          String
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  phoneNumber          String?
  status               VendorStatus @default(ACTIVE)
  addressLine1         String?
  addressLine2         String?
  city                 String?
  country              String?      @default("India")
  pincode              String?
  state                String?
  /// Snapshot of the GST registry record, taken when the GSTIN is verified and
  /// editable by hand afterwards. Kept as plain columns so a cancelled or
  /// composition-scheme vendor can be filtered for.
  gstStatus            String?
  taxpayerType         String?
  businessConstitution String?
  gstRegistrationDate  String?
  gstCancellationDate  String?
  stateJurisdiction    String?
  natureOfBusiness     String?
  blockStatus          String?
  einvoiceStatus       String?

  vendorType           VendorType   @default(SUPPLIER)
  /// Column mapping remembered from a previous quotation import, keyed by this
  /// vendor's own header wording. Null until a user chooses to remember one.
  quotationMapping Json?
  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  capabilities     VendorMaterialCapability[]
  indents          Indent[]                   @relation("IndentVendor")
  quotes           VendorQuote[]
  purchaseOrders   PurchaseOrder[]

  @@unique([workspaceId, vendorId])
  @@index([workspaceId])
  @@index([name])
  @@index([status])
  @@index([gstNumber])
  @@map("vendor")
}

enum VendorType {
  SUPPLIER
  CONTRACTOR
}

/// One row per calendar month counting the GSTIN lookups that actually spent a
/// provider credit, so the free monthly allowance cannot be run dry. Global
/// rather than per-workspace: the provider account, and its credits, are shared
/// by the whole deployment.
model GstinLookupUsage {
  month     String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("gstin_lookup_usage")
}

model VendorQuote {
  id                   String           @id @default(uuid())
  lineItemId           String
  vendorId             String
  unitPrice            Decimal          @db.Decimal(15, 2)
  quantity             Decimal          @db.Decimal(15, 3)
  totalPrice           Decimal          @db.Decimal(15, 2)
  currency             String           @default("INR")
  leadTimeDays         Int?
  validUntil           DateTime?
  notes                String?
  attachmentUrl        String?
  status               QuoteStatus      @default(SUBMITTED)
  submittedAt          DateTime         @default(now())
  reviewedAt           DateTime?
  reviewedById         String?
  rejectionReason      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  approvedForLineItems IndentLineItem[] @relation("ApprovedQuote")
  lineItem             IndentLineItem   @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  reviewedBy           WorkspaceMember? @relation("QuoteReviewer", fields: [reviewedById], references: [id])
  vendor               Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([lineItemId, vendorId])
  @@index([lineItemId])
  @@index([vendorId])
  @@index([status])
  @@map("vendor_quote")
}

