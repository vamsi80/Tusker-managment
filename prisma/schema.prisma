/// The two legal entities that issue purchase orders. Their addresses, GSTINs
/// and where each one's numbering picks up live in
/// src/lib/procurement/purchase-order.ts.
enum BuyerCompany {
  WT
  PL
}

/// A purchase order issued to a vendor. Money is paise, matching indent line
/// items. Line items are copied in rather than referenced: a PO is a contract,
/// so editing a catalogue entry or the indent behind it must not change one.
model PurchaseOrder {
  id              String       @id @default(uuid())
  workspaceId     String
  /// WT/26-27/0063 - entity, financial year, sequence.
  poNumber        String
  company         BuyerCompany
  financialYear   String
  vendorId        String
  indentId        String?
  /// The vendor's own quotation / PI reference, printed on the document.
  referenceNo     String?
  poDate          DateTime     @default(now())
  deliveryAddress String
  /// Same state as the buying entity: tax splits CGST + SGST, otherwise IGST.
  intraState      Boolean      @default(true)
  subtotal        Int
  /// Extras carried over from the indent and printed under the subtotal.
  /// Percentages are a share of the subtotal; transport and labour are paise.
  exciseDutyPercent Decimal?   @db.Decimal(5, 2)
  vatPercent        Decimal?   @db.Decimal(5, 2)
  transportCharge   Int        @default(0)
  labourCharge      Int        @default(0)
  cgst            Int
  sgst            Int
  igst            Int
  /// Grand total is rounded to the rupee; this holds the difference.
  roundOff        Int          @default(0)
  grandTotal      Int
  status          POStatus     @default(ORDERED)
  /// Payment terms and conditions as printed, one per line. Copied from the
  /// standard set when the PO is raised, then editable per order.
  terms           String[]
  notes           String?
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vendor    Vendor          @relation(fields: [vendorId], references: [id])
  indent    Indent?         @relation(fields: [indentId], references: [id], onDelete: SetNull)
  createdBy WorkspaceMember @relation("POCreator", fields: [createdById], references: [id])
  items     POLineItem[]

  @@unique([workspaceId, poNumber])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([vendorId])
  @@index([indentId])
  @@map("purchase_order")
}

model POLineItem {
  id          String @id @default(uuid())
  poId        String
  description String
  unit        String
  quantity    Int
  /// Paise per unit, and quantity x rate.
  rate        Int
  amount      Int
  /// Whole-percent GST for this line (0 / 5 / 12 / 18 / 28).
  taxPercent  Int    @default(18)
  sortOrder   Int    @default(0)

  po PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@map("po_line_item")
}

/// Per-entity, per-financial-year PO counter, so White Tusker and Palm Length
/// number their orders independently.
model PoSequence {
  workspaceId   String
  company       BuyerCompany
  financialYear String
  next          Int

  @@id([workspaceId, company, financialYear])
  @@map("po_sequence")
}

