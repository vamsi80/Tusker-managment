  ACCEPTED
  DECLINED
  TENTATIVE
}

model Meeting {
  id              String            @id @default(uuid())
  workspaceId     String
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  location        String?
  meetingUrl      String?
  type            MeetingType       @default(INTERNAL)
  status          MeetingStatus     @default(SCHEDULED)
  color           String?           @default("indigo")
  reminderMinutes Int               @default(15)
  isAllDay        Boolean           @default(false)
  organizerId     String
